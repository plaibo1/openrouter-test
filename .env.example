OPENROUTER_API_KEY=sk-or-v1-...
# Модель суммари по умолчанию (пусто = суммари выключено, в UI можно включить)
# SUMMARY_MODEL=google/gemini-3.5-flash
PORT=3000
# Прокси для запросов к OpenRouter (если сервер в регионе, который OpenRouter блокирует).
# HTTP: host:port:user:pass или http://user:pass@host:port
# SOCKS5: socks5://host:port:user:pass или socks5://user:pass@host:port
# OPENROUTER_PROXY=
